# Copy this file to .env and fill in the required values.
# .env must never be committed to git.

# =============================================================================
# REQUIRED  —  app will crash on startup if these are missing
# =============================================================================

GEMINI_API_KEY=your-gemini-api-key-here
FLASK_SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars

# =============================================================================
# OPTIONAL  —  safe defaults are built into config/settings.py
# =============================================================================

# --- Gemini generation parameters ---
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024

# --- Dataset location ---
# Default: <project_root>/data/cities/
# On cPanel, set this to the absolute path of your cities folder, e.g.:
# DATASET_ROOT=/home/yourusername/airbnb/data/cities
# DATASET_ROOT=

# --- Session lifetime (seconds) ---
# Default: 86400 = 24 hours
SESSION_LIFETIME_SECONDS=86400

# --- Flask ---
# NEVER set FLASK_DEBUG=true on cPanel — Python tracebacks would be visible in HTTP responses
FLASK_DEBUG=false

# --- K-Means adaptive thresholds ---
KMEANS_THRESH_SMALL=300
KMEANS_THRESH_MEDIUM=1000
KMEANS_RANDOM_STATE=42

# --- Similarity & recommendation ---
SIMILARITY_TOP_K=10
RECOMMENDATION_COMPS=5

# --- Cross-city fallback ---
# Max confidence when the requested city has no data (0.0–1.0, default 0.55 = 55%)
CROSS_CITY_CONFIDENCE_PENALTY=0.55
